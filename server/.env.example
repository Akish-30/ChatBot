# ==========================================================
# REAL EMAIL OTP CONFIGURATION (Gmail SMTP)
# ==========================================================
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a 16-character App Password for "Mail"
# 3. Paste your Gmail address and App Password below:
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ==========================================================
# REAL MOBILE SMS OTP CONFIGURATION (Option A: Fast2SMS - India +91)
# ==========================================================
# Get a free API key at https://www.fast2sms.com/
FAST2SMS_API_KEY=

# ==========================================================
# REAL MOBILE SMS OTP CONFIGURATION (Option B: Twilio - Global)
# ==========================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
